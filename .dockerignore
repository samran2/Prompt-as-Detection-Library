# Deny the repository by default. Re-open only immutable runtime inputs used by
# apps/research-api/Dockerfile. This prevents Git data, credentials, local output,
# test evidence and unrelated source from entering the Docker build context.
**

!.dockerignore
!package.json
!LICENSE

!apps/
!apps/research-api/
!apps/research-api/Dockerfile
!apps/research-api/package.json
!apps/research-api/src/
!apps/research-api/src/catalog-adapter.mjs
!apps/research-api/src/handler.mjs
!apps/research-api/src/server.mjs

!packages/
!packages/core/
!packages/core/package.json
!packages/core/src/
!packages/core/src/research-catalog.mjs

!demo/
!demo/catalog.js

!library/
!library/prompts/
!library/prompts/enterprise/
!library/prompts/enterprise/T*.txt
!library/prompts/mobile/
!library/prompts/mobile/T*.txt
!library/prompts/ics/
!library/prompts/ics/T*.txt

!content/
!content/prompts/
!content/prompts/index.json

!sources/
!sources/attack-19.2/
!sources/attack-19.2/manifest.json
!sources/attack-19.2/raw/
!sources/attack-19.2/raw/LICENSE.txt
