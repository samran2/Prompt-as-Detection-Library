{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prompt-as-Detection local environment profile v1",
  "description": "User-supplied or example context, never collection or detection validation evidence. Runtime additionally enforces 128 KiB UTF-8 and well-formed Unicode.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "revision",
    "name",
    "target",
    "system",
    "dataSources",
    "tables",
    "fieldMappings",
    "limitations",
    "provenance"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "name": {
      "type": "string",
      "maxLength": 120,
      "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f]*(?![\\s\\S])",
      "minLength": 1,
      "allOf": [
        {
          "pattern": "\\S"
        }
      ]
    },
    "target": {
      "type": "string",
      "enum": [
        "Platform-neutral",
        "Panther Python",
        "Sentinel KQL",
        "Defender XDR",
        "Splunk SPL",
        "Sigma"
      ]
    },
    "system": {
      "type": "string",
      "maxLength": 4000,
      "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f]*(?![\\s\\S])"
    },
    "dataSources": {
      "type": "string",
      "maxLength": 4000,
      "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f]*(?![\\s\\S])"
    },
    "tables": {
      "type": "string",
      "maxLength": 4000,
      "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f]*(?![\\s\\S])"
    },
    "fieldMappings": {
      "type": "string",
      "maxLength": 4000,
      "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f]*(?![\\s\\S])"
    },
    "limitations": {
      "type": "string",
      "maxLength": 4000,
      "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f]*(?![\\s\\S])"
    },
    "provenance": {
      "type": "string",
      "enum": [
        "user",
        "example"
      ]
    }
  }
}
