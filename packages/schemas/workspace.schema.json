{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prompt-as-Detection local workspace v1",
  "description": "Private local drafts, never review or validation evidence. Runtime also enforces a 5 MiB UTF-8 document limit and unique draft keys and collection IDs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "sources",
    "drafts",
    "context",
    "contextInput",
    "collections",
    "favorites",
    "flow",
    "view"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
    },
    "name": {
      "type": "string",
      "maxLength": 120,
      "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f]*(?![\\s\\S])",
      "minLength": 1,
      "allOf": [
        {
          "pattern": "\\S"
        }
      ]
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attack",
        "atlas",
        "d3fend",
        "car",
        "attackFlow"
      ],
      "properties": {
        "attack": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f]*(?![\\s\\S])",
          "minLength": 1,
          "allOf": [
            {
              "pattern": "\\S"
            }
          ]
        },
        "atlas": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f]*(?![\\s\\S])",
          "minLength": 1,
          "allOf": [
            {
              "pattern": "\\S"
            }
          ]
        },
        "d3fend": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f]*(?![\\s\\S])",
          "minLength": 1,
          "allOf": [
            {
              "pattern": "\\S"
            }
          ]
        },
        "car": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f]*(?![\\s\\S])",
          "minLength": 1,
          "allOf": [
            {
              "pattern": "\\S"
            }
          ]
        },
        "attackFlow": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f]*(?![\\s\\S])",
          "minLength": 1,
          "allOf": [
            {
              "pattern": "\\S"
            }
          ]
        }
      }
    },
    "drafts": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "techniqueId",
          "mode",
          "target",
          "text",
          "template",
          "templateSha256",
          "context"
        ],
        "properties": {
          "techniqueId": {
            "type": "string",
            "maxLength": 14,
            "pattern": "^(?:T[0-9]{4}|AML\\.T[0-9]{4})(?:\\.[0-9]{3})?(?![\\s\\S])"
          },
          "mode": {
            "type": "string",
            "enum": [
              "detect",
              "hunt",
              "triage",
              "validate"
            ]
          },
          "target": {
            "type": "string",
            "enum": [
              "Platform-neutral",
              "Panther Python",
              "Sentinel KQL",
              "Defender XDR",
              "Splunk SPL",
              "Sigma"
            ]
          },
          "text": {
            "type": "string",
            "maxLength": 204800,
            "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f]*(?![\\s\\S])"
          },
          "template": {
            "type": "string",
            "maxLength": 204800,
            "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f]*(?![\\s\\S])"
          },
          "templateSha256": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
          },
          "context": {
            "type": "string",
            "maxLength": 4000,
            "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f]*(?![\\s\\S])"
          }
        }
      }
    },
    "context": {
      "type": "string",
      "maxLength": 4000,
      "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f]*(?![\\s\\S])"
    },
    "contextInput": {
      "type": "string",
      "maxLength": 4000,
      "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f]*(?![\\s\\S])"
    },
    "collections": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "techniqueIds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 36,
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
          },
          "name": {
            "type": "string",
            "maxLength": 120,
            "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f]*(?![\\s\\S])",
            "minLength": 1,
            "allOf": [
              {
                "pattern": "\\S"
              }
            ]
          },
          "techniqueIds": {
            "type": "array",
            "maxItems": 1115,
            "items": {
              "type": "string",
              "maxLength": 14,
              "pattern": "^(?:T[0-9]{4}|AML\\.T[0-9]{4})(?:\\.[0-9]{3})?(?![\\s\\S])"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "favorites": {
      "type": "array",
      "maxItems": 1115,
      "items": {
        "type": "string",
        "maxLength": 14,
        "pattern": "^(?:T[0-9]{4}|AML\\.T[0-9]{4})(?:\\.[0-9]{3})?(?![\\s\\S])"
      },
      "uniqueItems": true
    },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "steps"
      ],
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 120,
          "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f]*(?![\\s\\S])",
          "minLength": 1,
          "allOf": [
            {
              "pattern": "\\S"
            }
          ]
        },
        "steps": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 14,
            "pattern": "^(?:T[0-9]{4}|AML\\.T[0-9]{4})(?:\\.[0-9]{3})?(?![\\s\\S])"
          }
        }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query",
        "domain",
        "tactic",
        "platform",
        "mode",
        "target",
        "technique",
        "compare",
        "theme",
        "tab",
        "paneWidth",
        "listScroll",
        "mobileView"
      ],
      "properties": {
        "query": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f]*(?![\\s\\S])"
        },
        "domain": {
          "type": "string",
          "enum": [
            "",
            "All",
            "Enterprise",
            "Mobile",
            "ICS",
            "OT",
            "ATLAS"
          ]
        },
        "tactic": {
          "type": "string",
          "maxLength": 100,
          "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f]*(?![\\s\\S])"
        },
        "platform": {
          "type": "string",
          "maxLength": 100,
          "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f]*(?![\\s\\S])"
        },
        "mode": {
          "type": "string",
          "enum": [
            "detect",
            "hunt",
            "triage",
            "validate"
          ]
        },
        "target": {
          "type": "string",
          "enum": [
            "Platform-neutral",
            "Panther Python",
            "Sentinel KQL",
            "Defender XDR",
            "Splunk SPL",
            "Sigma"
          ]
        },
        "technique": {
          "type": "string",
          "maxLength": 14,
          "pattern": "^(?:(?:T[0-9]{4}|AML\\.T[0-9]{4})(?:\\.[0-9]{3})?)?(?![\\s\\S])"
        },
        "compare": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "string",
            "maxLength": 14,
            "pattern": "^(?:T[0-9]{4}|AML\\.T[0-9]{4})(?:\\.[0-9]{3})?(?![\\s\\S])"
          },
          "uniqueItems": true
        },
        "theme": {
          "type": "string",
          "enum": [
            "system",
            "light",
            "dark",
            "contrast"
          ]
        },
        "tab": {
          "type": "string",
          "enum": [
            "prompt",
            "evidence",
            "defenses",
            "flow"
          ]
        },
        "paneWidth": {
          "type": "integer",
          "minimum": 240,
          "maximum": 480
        },
        "listScroll": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000000
        },
        "mobileView": {
          "type": "string",
          "enum": [
            "list",
            "detail"
          ]
        }
      }
    }
  }
}
