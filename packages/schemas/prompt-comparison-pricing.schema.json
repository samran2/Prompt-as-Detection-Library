{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prompt comparison operator-verified pricing snapshot v1",
  "description": "Input rates are operator attestations, not automatically verified billing guarantees. Runtime requires exact requested model match and a timestamp at most 30 days old.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "currency", "model", "inputUsdPerMillion", "outputUsdPerMillion", "maxInputTokens", "verifiedAt", "sourceUrl", "operatorVerified"],
  "properties": {
    "schemaVersion": {"const": 1},
    "currency": {"const": "USD"},
    "model": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,119}$"},
    "inputUsdPerMillion": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000000},
    "outputUsdPerMillion": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000000},
    "maxInputTokens": {"type": "integer", "minimum": 1024, "maximum": 10000000},
    "verifiedAt": {"type": "string", "format": "date-time"},
    "sourceUrl": {"enum": ["https://openai.com/api/pricing/", "https://developers.openai.com/api/docs/pricing"]},
    "operatorVerified": {"const": true}
  }
}
